#!/usr/bin/python3

"""Repack an official Odoo deb with its source-declared pypdf alternative."""

import copy
import gzip
import hashlib
import io
import lzma
import os
from pathlib import Path
import re
import subprocess
import sys
import tarfile
import tempfile


AR_MAGIC = b"!<arch>\n"
DEPENDENCY = b"python3-pypdf2 | python3-pypdf"
COLLAPSED = re.compile(
    rb"(?<![-A-Za-z0-9+.])python3-pypdf2(?![-A-Za-z0-9+.])"
)


def fail(message):
    raise SystemExit(f"odoo-repack-package: {message}")


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def ar_members(path):
    members = []
    with path.open("rb") as archive:
        if archive.read(len(AR_MAGIC)) != AR_MAGIC:
            fail("input is not a Debian ar archive")
        while header := archive.read(60):
            if len(header) != 60 or header[58:60] != b"`\n":
                fail("invalid ar member header")
            name = header[:16].decode("ascii").strip().rstrip("/")
            if not name or name.startswith("#1/") or name in ("/", "//"):
                fail("unsupported ar member name")
            try:
                size = int(header[48:58])
            except ValueError:
                fail("invalid ar member size")
            offset = archive.tell()
            members.append((name, header, offset, size))
            archive.seek(size + size % 2, os.SEEK_CUR)
    return members


def read_member(path, member):
    _, _, offset, size = member
    with path.open("rb") as archive:
        archive.seek(offset)
        payload = archive.read(size)
    if len(payload) != size:
        fail("truncated ar member")
    return payload


def decompressed_control(name, payload):
    if name == "control.tar.zst":
        result = subprocess.run(
            ["zstd", "--quiet", "--decompress", "--stdout"],
            input=payload,
            stdout=subprocess.PIPE,
            check=True,
        )
        return result.stdout
    if name == "control.tar.xz":
        return lzma.decompress(payload)
    if name == "control.tar.gz":
        return gzip.decompress(payload)
    fail(f"unsupported control archive {name}")


def compressed_control(name, payload):
    if name == "control.tar.zst":
        result = subprocess.run(
            ["zstd", "--quiet", "-19", "--threads=1", "--stdout"],
            input=payload,
            stdout=subprocess.PIPE,
            check=True,
        )
        return result.stdout
    if name == "control.tar.xz":
        return lzma.compress(payload, format=lzma.FORMAT_XZ, preset=9)
    if name == "control.tar.gz":
        return gzip.compress(payload, compresslevel=9, mtime=0)
    fail(f"unsupported control archive {name}")


def field(control, name):
    match = re.search(
        rb"(?m)^" + re.escape(name.encode()) + rb":([^\n]*(?:\n[ \t][^\n]*)*)",
        control,
    )
    if not match:
        fail(f"missing {name} field")
    return match.group(1)


def rewrite_control(control):
    if field(control, "Package").strip() != b"odoo":
        fail("package name is not odoo")
    if field(control, "Architecture").strip() != b"all":
        fail("package architecture is not all")
    depends = field(control, "Depends")
    if DEPENDENCY in depends:
        fail("pypdf dependency already preserves the alternative")
    if len(COLLAPSED.findall(depends)) != 1:
        fail("Depends must contain exactly one collapsed python3-pypdf2")
    rewritten = COLLAPSED.sub(DEPENDENCY, depends, count=1)
    start, end = re.search(
        rb"(?m)^Depends:([^\n]*(?:\n[ \t][^\n]*)*)", control
    ).span(1)
    return control[:start] + rewritten + control[end:]


def rebuild_control_tar(payload):
    source = io.BytesIO(payload)
    output = io.BytesIO()
    found = 0
    with tarfile.open(fileobj=source, mode="r:") as original:
        with tarfile.open(fileobj=output, mode="w", format=tarfile.GNU_FORMAT) as rebuilt:
            for member in original:
                info = copy.copy(member)
                data = original.extractfile(member) if member.isfile() else None
                if member.name.lstrip("./") == "control":
                    if not member.isfile():
                        fail("control is not a regular file")
                    rewritten = rewrite_control(data.read())
                    data = io.BytesIO(rewritten)
                    info.size = len(rewritten)
                    found += 1
                rebuilt.addfile(info, data)
    if found != 1:
        fail("control archive must contain exactly one control file")
    return output.getvalue()


def write_ar(source_path, output_path, members, control_name, control_payload):
    with source_path.open("rb") as source, output_path.open("xb") as output:
        output.write(AR_MAGIC)
        for name, header, offset, size in members:
            if name == control_name:
                payload = control_payload
                rewritten_header = bytearray(header)
                encoded_size = f"{len(payload):>10}".encode("ascii")
                if len(encoded_size) != 10:
                    fail("rewritten control archive is too large")
                rewritten_header[48:58] = encoded_size
                output.write(rewritten_header)
                output.write(payload)
                if len(payload) % 2:
                    output.write(b"\n")
                continue
            source.seek(offset - 60)
            remaining = 60 + size + size % 2
            while remaining:
                chunk = source.read(min(1024 * 1024, remaining))
                if not chunk:
                    fail("truncated ar archive while copying payload")
                output.write(chunk)
                remaining -= len(chunk)


def member_sha256(path, member):
    digest = hashlib.sha256()
    _, _, offset, size = member
    with path.open("rb") as archive:
        archive.seek(offset)
        remaining = size
        while remaining:
            chunk = archive.read(min(1024 * 1024, remaining))
            if not chunk:
                fail("truncated payload member")
            digest.update(chunk)
            remaining -= len(chunk)
    return digest.hexdigest()


def main():
    if len(sys.argv) != 3:
        fail("usage: odoo-repack-package INPUT.deb OUTPUT.deb")
    source_path = Path(sys.argv[1]).resolve()
    output_path = Path(sys.argv[2]).resolve()
    if not source_path.is_file():
        fail("input package is not a regular file")
    if source_path == output_path or output_path.exists():
        fail("output path must be new and distinct from input")

    members = ar_members(source_path)
    control_members = [member for member in members if member[0].startswith("control.tar.")]
    data_members = [member for member in members if member[0].startswith("data.tar.")]
    if len(control_members) != 1 or len(data_members) != 1:
        fail("package must contain one control archive and one data archive")
    control_member = control_members[0]
    original_control = decompressed_control(
        control_member[0], read_member(source_path, control_member)
    )
    rebuilt_control = compressed_control(
        control_member[0], rebuild_control_tar(original_control)
    )

    output_path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=output_path.parent) as temporary:
        temporary_output = Path(temporary) / output_path.name
        write_ar(
            source_path,
            temporary_output,
            members,
            control_member[0],
            rebuilt_control,
        )
        rewritten_members = ar_members(temporary_output)
        rewritten_data = [
            member for member in rewritten_members if member[0].startswith("data.tar.")
        ][0]
        original_payload_sha256 = member_sha256(source_path, data_members[0])
        if member_sha256(temporary_output, rewritten_data) != original_payload_sha256:
            fail("upstream payload changed during repack")
        os.replace(temporary_output, output_path)

    print(f"upstream_package_sha256={sha256(source_path)}")
    print(f"repacked_package_sha256={sha256(output_path)}")
    print(f"upstream_payload_sha256={original_payload_sha256}")
    print("dependency_rewrite=python3-pypdf2_to_python3-pypdf2_or_python3-pypdf")


if __name__ == "__main__":
    main()
